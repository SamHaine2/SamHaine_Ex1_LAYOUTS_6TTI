<Window x:Class="SamHaine_LAYOUTS_6TTI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SamHaine_LAYOUTS_6TTI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0">
            <Button Content="Bouton 1" Height="100"/>
            <Button Content="Bouton 2" Height="100"/>
        </StackPanel>

        <DockPanel Grid.Row="0" Grid.Column="1">
            <Button Content="Top" DockPanel.Dock="Top"/>
            <Button Content="Bottom" DockPanel.Dock="Bottom"/>
            <Button Content="Left" DockPanel.Dock="Left"/>
            <Button Content="Right" DockPanel.Dock="Right"/>
            <Button Content="Direction"/>
        </DockPanel>

        <WrapPanel Grid.Row="1" Grid.Column="0" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center" 
                   Width="300">
            <Button Content="Bouton 1" Width="100" Height="20"/>
            <Button Content="Bouton 2" Width="100" Height="20"/>
            <Button Content="Bouton 3" Width="100" Height="20"/>
            <Button Content="Bouton 4" Width="100" Height="40"/>
            <Button Content="Bouton 5" Width="100" Height="40"/>
            <Button Content="Bouton 6" Width="100" Height="40"/>
        </WrapPanel>

        <Canvas Grid.Row="1" Grid.Column="1">
            <Ellipse Fill="Black" Width="150" Height="150" Canvas.Left="75" Canvas.Top="12.5"/>
            <Ellipse Fill="Yellow" Width="100" Height="100" Canvas.Left="100" Canvas.Top="37.5"/>
            <Ellipse Fill="Red" Width="50" Height="50" Canvas.Left="125" Canvas.Top="62.5"/>
        </Canvas>
    </Grid>
</Window>